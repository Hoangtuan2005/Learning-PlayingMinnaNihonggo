  "grammar": [
    {
      "id": "l05_g01",
      "pattern": "1. Danh từ (địa điểm) へ 行きます / 来ます / 帰ります",
      "explanation": "Khi sử dụng động từ chỉ sự di chuyển (行きます: đi, 来ます: đến, 帰ります: về), ta dùng trợ từ へ (phát âm là e) đặt sau danh từ chỉ địa điểm để chỉ phương hướng di chuyển tới địa điểm đó.",
      "note": "Trợ từ へ được viết bằng chữ cái へ (he) nhưng luôn phát âm là え (e).",
      "examples": [
        {
          "jp": "きょうとへ いきます。",
          "vi": "Tôi đi Kyoto."
        },
        {
          "jp": "にほんへ きました。",
          "vi": "Tôi đã đến Nhật Bản."
        },
        {
          "jp": "うちへ かえります。",
          "vi": "Tôi trở về nhà."
        }
      ]
    },
    {
      "id": "l05_g02",
      "pattern": "2. どこ [へ] も 行きません / 行きませんでした (Phủ định hoàn toàn)",
      "explanation": "Khi muốn phủ định hoàn toàn đối tượng trong phạm vi được hỏi bởi nghi vấn từ (như どこ: ở đâu, なに: cái gì, だれ: ai), ta thêm trợ từ も vào sau nghi vấn từ và chuyển động từ sang thể phủ định.\n• どこ [へ] も いきません: Không đi đâu cả.\n• なにも たべません: Không ăn gì cả.\n• だれも きませんでした: Đã không có ai đến cả.",
      "note": "Trong trường hợp どこへも, trợ từ へ có thể lược bỏ thành どこも.",
      "examples": [
        {
          "jp": "どこ[へ]も いきません。",
          "vi": "Tôi không đi đâu cả."
        },
        {
          "jp": "きのう どこへ いきましたか。……どこ[へ]も いきませんでした。",
          "vi": "Hôm qua anh đã đi đâu? ……Tôi đã không đi đâu cả."
        }
      ]
    },
    {
      "id": "l05_g03",
      "pattern": "3. Danh từ (phương tiện) で 行きます / 来ます / 帰ります",
      "explanation": "Trợ từ で biểu thị phương tiện, cách thức tiến hành hành động. Khi đi với động từ di chuyển, で đứng sau danh từ chỉ phương tiện giao thông (tàu, xe, máy bay...).\n• Lưu ý: Trường hợp đi bộ thì dùng あるいて (歩いて), KHÔNG dùng trợ từ で.",
      "note": "Đi bộ: あるいて いきます (Đi bộ đi), không nói あるいてで.",
      "examples": [
        {
          "jp": "でんしゃで いきます。",
          "vi": "Tôi đi bằng tàu điện."
        },
        {
          "jp": "タクシーで きました。",
          "vi": "Tôi đã đến bằng tắc-xi."
        },
        {
          "jp": "えきから あるいて かえりました。",
          "vi": "Tôi đã đi bộ từ ga về nhà."
        }
      ]
    },
    {
      "id": "l05_g04",
