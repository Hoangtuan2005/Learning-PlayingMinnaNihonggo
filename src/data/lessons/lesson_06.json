  "grammar": [
    {
      "id": "l06_g01",
      "pattern": "1. Danh từ を Động từ (ngoại động từ)",
      "explanation": "Trợ từ を (viết bằng chữ を, phát âm là o) đứng sau danh từ để biểu thị đối tượng trực tiếp (tân ngữ) chịu sự tác động của ngoại động từ.",
      "note": "Chữ を chỉ dùng làm trợ từ ngữ pháp, không dùng để ghép từ thông thường.",
      "examples": [
        {
          "jp": "ジュースを のみます。",
          "vi": "Tôi uống nước hoa quả."
        },
        {
          "jp": "ほんを よみます。",
          "vi": "Tôi đọc sách."
        },
        {
          "jp": "しゃしんを とります。",
          "vi": "Tôi chụp ảnh."
        }
      ]
    },
    {
      "id": "l06_g02",
      "pattern": "2. Danh từ を します",
      "explanation": "Động từ します mang nghĩa rất rộng, kết hợp với nhiều danh từ để tạo thành hành động cụ thể:\n• Chơi thể thao, trò chơi: サッカーを します (chơi bóng đá), トランプを します (chơi bài).\n• Tổ chức sự kiện: パーティーを します (mở tiệc), かいぎを します (tổ chức họp).\n• Hành vi, công việc: しゅくだいを します (làm bài tập), しごとを します (làm việc).",
      "note": "Ví dụ: でんわを します (gọi điện thoại).",
      "examples": [
        {
          "jp": "サッカーを します。",
          "vi": "Tôi chơi bóng đá."
        },
        {
          "jp": "しゅくだいを します。",
          "vi": "Tôi làm bài tập về nhà."
        }
      ]
    },
    {
      "id": "l06_g03",
      "pattern": "3. 何を しますか (Làm cái gì?)",
      "explanation": "Mẫu câu hỏi xem đối phương làm hành động gì vào một thời điểm nhất định.",
      "note": "Trả lời nêu trực tiếp cụm [Danh từ を Động từ].",
      "examples": [
        {
          "jp": "げつようび 何を しますか。……きょうとへ いきます。",
          "vi": "Thứ hai anh làm gì? ……Tôi đi Kyoto."
        },
        {
          "jp": "きのう 何を しましたか。……サッカーを しました。",
          "vi": "Hôm qua anh đã làm gì? ……Tôi đã chơi bóng đá."
        }
      ]
    },
    {
      "id": "l06_g04",
      "pattern": "4. なん và なに (Cùng chữ Hán 何)",
      "explanation": "Chữ 何 có hai cách đọc là なん và なに:\n1) Đọc là なん khi âm tiếp theo bắt đầu bằng hàng た, だ, な (何ですか: なん、何の本: なん、何と言いますか: なん) hoặc khi đứng trước các trợ số từ (何時: なんじ、何人: なんにん).\n2) Đọc là なに trong các trường hợp còn lại (何を買いますか: なに、何が好きですか: なに).",
      "note": "何で (なんで) có thể hỏi phương tiện hoặc nguyên nhân lý do; nếu muốn hỏi phương tiện rõ ràng thì dùng なにで.",
      "examples": [
        {
          "jp": "それは 何ですか。……じしょです。",
          "vi": "Đó là cái gì? ……Là từ điển."
        },
        {
          "jp": "何を かいますか。……パンを かいます。",
          "vi": "Anh mua cái gì? ……Tôi mua bánh mì."
        }
      ]
    },
    {
      "id": "l06_g05",
      "pattern": "5. Danh từ (địa điểm) で Động từ",
      "explanation": "Trợ từ で đặt sau danh từ chỉ địa điểm để biểu thị nơi chốn diễn ra một hành động cụ thể (khác với に dùng cho sự tồn tại あります/います).",
      "note": "Phân biệt: えきで しんぶんを かいます (mua báo ở ga) vs えきに ぎんこうが あります (có ngân hàng ở ga).",
      "examples": [
        {
