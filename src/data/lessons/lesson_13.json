  "grammar": [
    {
      "id": "l13_g01",
      "pattern": "1. Danh từ が ほしいです (Muốn có cái gì)",
      "explanation": "ほしい là tính từ đuôi い biểu thị mong muốn sở hữu một đồ vật hoặc một đối tượng nào đó. Đối tượng mong muốn đi với trợ từ が.\n• Phủ định: ほしくないです (Không muốn có).\n• Quá khứ: ほしかったです | ほしくなかったです.",
      "note": "Chỉ dùng để diễn đạt ý muốn của bản thân người nói (hoặc người nghe trong câu hỏi), KHÔNG dùng cho ngôi thứ ba.",
      "examples": [
        {
          "jp": "わたしは ともだちが ほしいです。",
          "vi": "Tôi muốn có bạn bè."
        },
        {
          "jp": "いま 何が いちばん ほしいですか。……くるまが ほしいです。",
          "vi": "Bây giờ anh muốn có cái gì nhất? ……Tôi muốn có một chiếc ô tô."
        },
        {
          "jp": "こどもが ほしいですか。……いいえ、ほしくないです。",
          "vi": "Anh/Chị có muốn có con không? ……Không, tôi không muốn."
        }
      ]
    },
    {
      "id": "l13_g02",
      "pattern": "2. Động từ (thể ます bỏ ます) + たいです (Muốn làm gì)",
      "explanation": "Mẫu câu biểu thị ý muốn thực hiện một hành vi, hành động nào đó:\n• Cách tạo: Động từ bỏ đuôi ます + たいです.\n• Tân ngữ của hành động có thể dùng trợ từ を hoặc trợ từ が.\n• Biến đổi như tính từ đuôi い: たべたい ➔ たべたくないです ➔ たべたかったです.",
      "note": "Không dùng để nói về mong muốn của người ngôi thứ ba; Không dùng để mời mọc trực tiếp đối phương (mời ăn dùng いかがですか).",
      "examples": [
        {
          "jp": "わたしは おきなわへ いきたいです。",
          "vi": "Tôi muốn đi Okinawa."
        },
        {
          "jp": "わたしは てんぷらを（が） たべたいです。",
          "vi": "Tôi muốn ăn món tôm chiên Tempura."
        },
        {
          "jp": "おなかが いたいですから、何も たべたくないです。",
          "vi": "Vì đau bụng nên tôi chẳng muốn ăn gì cả."
        }
      ]
    },
    {
      "id": "l13_g03",
      "pattern": "3. Danh từ (địa điểm) へ [Động từ (bỏ ます) / Danh từ] に 行きます / 来ます / 帰ります",
      "explanation": "Dùng trợ từ に để biểu thị mục đích của hành động di chuyển (đi, đến, về đâu để làm gì):\n• V(bỏ ます) + に: たべに いきます (đi để ăn), かいに いきます (đi để mua).\n• Danh từ hành vi + に: かいものに いきます (đi mua sắm), べんきょうに きました (đến để học).",
      "note": "Khi đứng trước các danh từ chỉ sự kiện như lễ hội, hòa nhạc... mục đích được hiểu là xem/tham gia sự kiện đó.",
      "examples": [
        {
          "jp": "こうべへ インドりょうりを たべに いきます。",
          "vi": "Tôi đi Kobe để ăn món ăn Ấn Độ."
        },
        {
          "jp": "こうべへ かいものに いきます。",
          "vi": "Tôi đi Kobe để mua sắm."
        },
        {
          "jp": "にほんへ びじゅつの べんきょうに きました。",
          "vi": "Tôi đã đến Nhật Bản để học mỹ thuật."
        }
      ]
    },
    {
      "id": "l13_g04",
      "pattern": "4. どこか / 何か (Đâu đó / Cái gì đó)",
      "explanation": "Nghi vấn từ kết hợp với trợ từ か biến thành đại từ bất định:\n• どこか: Đâu đó, một nơi nào đó.\n• 何か: Cái gì đó, một thứ gì đó.\n• Các trợ từ へ, を khi đi cùng có thể được lược bớt (どこか[へ] いきます, 何か[を] のみます).",
      "note": "Phân biệt: 何かを 食べます (ăn cái gì đó) vs 何を 食べますか (ăn cái gì?).",
      "examples": [
        {
          "jp": "ふゆやすみは どこか[へ] いきましたか。……はい、ほっかいどうへ スキーに いきました。",
          "vi": "Kỳ nghỉ đông anh có đi đâu đó không? ……Có, tôi đã đi Hokkaido để trượt tuyết."
        },
        {
          "jp": "のどが かわきましたから、何か[を] のみたいです。",
          "vi": "Vì khát nước nên tôi muốn uống cái gì đó."
        }
      ]
    },
    {
      "id": "l13_g05",
      "pattern": "5. ご〜 (Tiền tố lịch sự kính trọng)",
      "explanation": "Tiền tố ご được thêm vào trước các từ Hán-Nhật (từ ghép 2 chữ Hán) để biểu thị sự lịch sự và tôn kính đối với người nghe (tương tự như お dùng cho từ thuần Nhật).",
      "note": "Ví dụ: ごちゅうもん (sự gọi món của quý khách), ごかぞく (gia đình của bạn).",
      "examples": [
        {
          "jp": "ごちゅうもんは？",
          "vi": "Quý khách dùng món gì ạ?"
        }
      ]
    }
  ]
}