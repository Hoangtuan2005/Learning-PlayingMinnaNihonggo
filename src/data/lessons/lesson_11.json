  "grammar": [
    {
      "id": "l11_g01",
      "pattern": "1. Cách đếm số lượng trong tiếng Nhật",
      "explanation": "Trong tiếng Nhật, cách đếm phụ thuộc vào bản chất của đồ vật/đối tượng:\n• Đồ vật nói chung (từ 1 đến 10): ひとつ, ふたつ, みっつ, よっつ, いつつ, むっつ, ななつ, やっつ, ここのつ, とお. Từ 11 trở lên dùng số đếm thường.\n• Người: ひとり (1 người), ふたり (2 người), 3人 (さんにん), 4人 (よにん - không nói よんにん)...\n• Máy móc, xe cộ: 〜台 (だい).\n• Vật mỏng, phẳng (giấy, áo, đĩa CD): 〜枚 (まい).\n• Số lần: 〜回 (かい).\n• Khoảng thời gian: 〜時間 (じかん - tiếng), 〜日 (にち - ngày), 〜週間 (しゅうかん - tuần), 〜か月 (かげつ - tháng), 〜年 (ねん - năm).",
      "note": "Hỏi số lượng chung: いくつ; Hỏi với trợ số từ: なん + trợ số từ (なんにん, なんだい, なんまい).",
      "examples": [
        {
          "jp": "かいぎしつに つくえが 7つ あります。",
          "vi": "Trong phòng họp có 7 cái bàn."
        },
        {
          "jp": "80えんの きってを 5まいと はがきを 2まい ください。",
          "vi": "Cho tôi 5 con tem 80 yên và 2 tấm bưu thiếp."
        }
      ]
    },
    {
      "id": "l11_g02",
      "pattern": "2. Cách dùng số lượng từ trong câu",
      "explanation": "Về nguyên tắc, số lượng từ đứng NGAY SAU trợ từ và TRƯỚC động từ:\n• Cấu trúc: [Danh từ + Trợ từ + Số lượng từ + Động từ].\n• Riêng số lượng từ chỉ khoảng thời gian thì vị trí khá linh hoạt.",
      "note": "Ví dụ: りんごを 4つ かいました (Tôi đã mua 4 quả táo) - không đặt 4つ trước trợ từ を.",
      "examples": [
        {
          "jp": "りんごを 4つ かいました。",
          "vi": "Tôi đã mua 4 quả táo."
        },
        {
          "jp": "がいこくじんの がくせいが 2人 います。",
          "vi": "Có 2 sinh viên người nước ngoài."
        },
        {
          "jp": "くにで 2か月 にほんごを べんきょうしました。",
          "vi": "Tôi đã học tiếng Nhật ở trong nước 2 tháng."
        }
      ]
    },
    {
      "id": "l11_g03",
      "pattern": "3. Số lượng từ (chỉ thời gian) に 〜回 Động từ (Tần suất)",
      "explanation": "Mẫu câu dùng để biểu thị tần suất thực hiện một hành động trong một khoảng thời gian nhất định.",
      "note": "Trợ từ に đặt sau mốc khoảng thời gian: 1か月に 2かい (1 tháng 2 lần), 1しゅうかんに 1かい (1 tuần 1 lần).",
      "examples": [
        {
          "jp": "1か月に 2かい えいがを みます。",
          "vi": "Một tháng tôi đi xem phim 2 lần."
        },
        {
          "jp": "1しゅうかんに 2かい テニスを します。",
          "vi": "Một tuần tôi chơi tennis 2 lần."
        }
      ]
    },
    {
      "id": "l11_g04",
      "pattern": "4. Số lượng từ だけ / Danh từ だけ (Chỉ ~)",
      "explanation": "Trợ từ だけ đặt sau số lượng từ hoặc danh từ để biểu thị ý nghĩa \"chỉ chừng đó, không nhiều hơn thế\" hoặc \"ngoài ra không còn đối tượng nào khác\".",
      "note": "Tương đương tiếng Việt: \"chỉ...\".",
      "examples": [
