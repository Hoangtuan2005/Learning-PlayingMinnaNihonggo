  "grammar": [
    {
      "id": "l04_g01",
      "pattern": "1. 今 〜時 〜分です (Bây giờ là mấy giờ mấy phút)",
      "explanation": "Để biểu thị thời gian trong tiếng Nhật, ta dùng chữ số kết hợp với trợ số từ 時 (じ - giờ) và 分 (ふん/ぷん - phút).\n• Quy tắc đọc phút: Đọc là ぷん (pun) sau 1, 3, 4, 6, 8, 10; đọc là ふん (fun) sau 2, 5, 7, 9.\n• Từ để hỏi: 何時 (なんじ - mấy giờ), 何分 (なんぷん - mấy phút).\n• Thêm 午前 (ごぜん - sáng/AM) hoặc 午後 (ごご - chiều/PM) phía trước số giờ khi cần làm rõ thời gian.",
      "note": "30 phút có thể nói là 半 (はん - rưỡi). Ví dụ: 6時半 (6 giờ rưỡi).",
      "examples": [
        {
          "jp": "いま なんじですか。……7じ 10ぷんです。",
          "vi": "Bây giờ là mấy giờ? ……7 giờ 10 phút."
        },
        {
          "jp": "ニューヨークは いま なんじですか。……ごぜん 0じ 10ぷんです。",
          "vi": "Ở New York bây giờ là mấy giờ? ……0 giờ 10 phút sáng."
        }
      ]
    },
    {
      "id": "l04_g02",
      "pattern": "2. Động từ ます / ません / ました / ませんでした",
      "explanation": "Động từ tiếng Nhật tận cùng bằng ます (thể lịch sự). Thể hiện 4 trạng thái thời gian và khẳng định/phủ định:\n• Khẳng định hiện tại / tương lai: V ます (Làm / Sẽ làm)\n• Phủ định hiện tại / tương lai: V ません (Không làm)\n• Khẳng định quá khứ: V ました (Đã làm)\n• Phủ định quá khứ: V ませんでした (Đã không làm)",
      "note": "Khi trả lời câu hỏi nghi vấn động từ, nhắc lại trực tiếp động từ (không dùng そうです / ちがいます).",
      "examples": [
        {
          "jp": "わたしは まいにち べんきょうします。",
          "vi": "Tôi học bài mỗi ngày."
        },
        {
          "jp": "まいあさ 6じに おきます。",
          "vi": "Mỗi sáng tôi thức dậy lúc 6 giờ."
        },
        {
          "jp": "きのう べんきょうしましたか。……はい、べんきょうしました。",
          "vi": "Hôm qua anh có học không? ……Vâng, tôi có học."
        },
        {
          "jp": "きのう べんきょうしましたか。……いいえ、べんきょうしませんでした。",
          "vi": "Hôm qua anh có học không? ……Không, tôi đã không học."
        }
      ]
    },
    {
      "id": "l04_g03",
      "pattern": "3. Danh từ (thời gian) に Động từ",
      "explanation": "Trợ từ に đứng sau danh từ chỉ thời gian cụ thể (có con số rõ ràng như giờ, ngày, tháng, năm) để biểu thị thời điểm mà hành động diễn ra.\n• CÓ dùng に: 6じに (lúc 6 giờ), 7がつ 2にちに (vào ngày 2 tháng 7).\n• KHÔNG dùng に: các từ chỉ thời gian tương đối như きょう (hôm nay), あした (ngày mai), きのう (hôm qua), まいにち (hàng ngày), こんしゅう (tuần này)...",
      "note": "Các thứ trong tuần (~ようび) có thể thêm hoặc không thêm に.",
      "examples": [
        {
          "jp": "6じはんに おきます。",
          "vi": "Tôi thức dậy vào lúc 6 giờ rưỡi."
        },
        {
          "jp": "7がつ 2にちに にほんへ きました。",
          "vi": "Tôi đã đến Nhật Bản vào ngày 2 tháng 7."
        },
        {
          "jp": "にちようび[に] ならへ いきます。",
          "vi": "Chủ nhật tôi sẽ đi Nara."
        }
      ]
    },
    {
      "id": "l04_g04",
      "pattern": "4. Danh từ 1 から Danh từ 2 まで (Từ ~ đến ~)",
      "explanation": "• から: Biểu thị điểm bắt đầu (thời gian hoặc địa điểm).\n• まで: Biểu thị điểm kết thúc (thời gian hoặc địa điểm).\n• Cặp trợ từ này có thể đi cùng nhau trong cụm [N1 から N2 まで], hoặc đứng độc lập riêng rẽ.",
