  "grammar": [
    {
      "id": "l14_g01",
      "pattern": "1. Các nhóm động từ trong tiếng Nhật (Nhóm I, II, III)",
      "explanation": "Động từ tiếng Nhật được phân loại thành 3 nhóm căn cứ vào âm đứng trước ます:\n• Nhóm I: Âm trước ます thuộc hàng い (như かきます, のみます, まちます).\n• Nhóm II: Đa số âm trước ます thuộc hàng え (たべます, あけます, みせます), cộng thêm một số động từ đặc biệt âm hàng い (みます, おきます, おります, かります).\n• Nhóm III: Bao gồm します, [Danh từ hành vi + します], và 来ます (きます).",
      "note": "Cần nắm vững nhóm để chia thể て, ない, た chính xác.",
      "examples": [
        {
          "jp": "かきます（Nhóm I）／ たべます（Nhóm II）／ べんきょうします（Nhóm III）",
          "vi": "Viết (Nhóm I) / Ăn (Nhóm II) / Học (Nhóm III)"
        }
      ]
    },
    {
      "id": "l14_g02",
      "pattern": "2. Thể て (Te-form) của động từ",
      "explanation": "Quy tắc chuyển từ thể ます sang thể て:\n• Nhóm I:\n  - Âm い, ち, り ➔ って (かいます ➔ かって, まちます ➔ まって, かえります ➔ かえって)\n  - Âm み, び, に ➔ んで (のみます ➔ のんで, よびます ➔ よんで, しにます ➔ しんで)\n  - Âm き ➔ いて (かきます ➔ かいて); [Ngoại lệ: いきます ➔ いって]\n  - Âm ぎ ➔ いで (いそぎます ➔ いそいで)\n  - Âm し ➔ して (かします ➔ かして)\n• Nhóm II: [Bỏ ます] + て (たべます ➔ たべて, みます ➔ みて)\n• Nhóm III: します ➔ して, きます ➔ きて",
      "note": "Ngoại lệ quan trọng: 行きます (いきます) chuyển thành 行って (いって), không phải いいて.",
      "examples": [
        {
          "jp": "かいて、のんで、いって、たべて、きて、して",
          "vi": "viết, uống, đi, ăn, đến, làm"
        }
      ]
    },
    {
      "id": "l14_g03",
      "pattern": "3. Động từ thể て ください (Hãy ~ / Xin vui lòng ~)",
      "explanation": "Mẫu câu dùng khi muốn nhờ vả, yêu cầu, chỉ thị hoặc khuyến khích đối phương làm một việc gì đó một cách lịch sự.\n• Khi nhờ vả lịch sự hơn, người ta thêm すみませんが ở đầu câu.",
      "note": "Không dùng mẫu này khi yêu cầu cấp trên làm gì cho mình.",
      "examples": [
        {
          "jp": "すみませんが、この かんじの よみかたを おしえて ください。",
          "vi": "Xin lỗi, hãy chỉ cho tôi cách đọc chữ Hán này."
        },
        {
          "jp": "ボールペンで なまえを かいて ください。",
          "vi": "Anh/Chị hãy viết tên bằng bút bi."
        },
        {
          "jp": "どうぞ たくさん たべて ください。",
          "vi": "Xin mời anh/chị hãy ăn nhiều vào nhé."
        }
      ]
    },
    {
      "id": "l14_g04",
      "pattern": "4. Động từ thể て います (Hành động đang diễn ra)",
      "explanation": "Mẫu câu biểu thị một hành động đang thực sự diễn ra tại thời điểm nói. Tương đương \"đang...\" trong tiếng Việt.",
      "note": "Phủ định: [V て いません] (Đang không...).",
      "examples": [
        {
          "jp": "ミラーさんは いま でんわを かけて います。",
          "vi": "Anh Miller bây giờ đang gọi điện thoại."
        },
        {
          "jp": "いま あめが ふって いますか。……はい、ふって います。",
          "vi": "Bây giờ trời có đang mưa không? ……Vâng, trời đang mưa."
        },
        {
          "jp": "いま あめが ふって いますか。……いいえ、ふって いません。",
          "vi": "Bây giờ trời có đang mưa không? ……Không, trời không mưa."
        }
      ]
    },
    {
      "id": "l14_g05",
      "pattern": "5. Động từ (thể ます bỏ ます) + ましょうか (Để tôi làm giúp ~ nhé?)",
