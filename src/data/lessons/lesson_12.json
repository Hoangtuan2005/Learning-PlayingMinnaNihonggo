  "grammar": [
    {
      "id": "l12_g01",
      "pattern": "1. Thì quá khứ của câu Danh từ và câu Tính từ đuôi な",
      "explanation": "• Khẳng định quá khứ: [Danh từ / Tính từ đuôi な (bỏ な)] + でした.\n  Ví dụ: きのうは 雨でした (Hôm qua trời mưa), しずかでした (Đã rất yên tĩnh).\n• Phủ định quá khứ: [Danh từ / Tính từ đuôi な (bỏ な)] + じゃ (では) ありませんでした.\n  Ví dụ: きのうの しけんは 簡単じゃ ありませんでした (Bài thi hôm qua không dễ chút nào).",
      "note": "Chia giống hệt câu danh từ.",
      "examples": [
        {
          "jp": "きのうは あめでした。",
          "vi": "Hôm qua trời đã mưa."
        },
        {
          "jp": "きのうの しけんは かんたんじゃ ありませんでした。",
          "vi": "Bài thi ngày hôm qua đã không hề dễ dàng."
        }
      ]
    },
    {
      "id": "l12_g02",
      "pattern": "2. Thì quá khứ của câu Tính từ đuôi い",
      "explanation": "• Khẳng định quá khứ: [Bỏ đuôi い] + かったです.\n  Ví dụ: あつい ➔ あつかったです (Đã nóng).\n• Phủ định quá khứ: [Bỏ đuôi い] + くなかったです.\n  Ví dụ: あつくなかったです (Đã không nóng).\n• Ngoại lệ đặc biệt: いいです ➔ よかったです (Đã tốt) | よくなかったです (Đã không tốt).",
      "note": "Tuyệt đối không dùng でした cho tính từ đuôi い (không nói あついでした).",
      "examples": [
        {
          "jp": "きのうは あつかったです。",
          "vi": "Hôm qua trời đã rất nóng."
        },
        {
          "jp": "きのうの パーティーは あまり たのしくなかったです。",
          "vi": "Bữa tiệc hôm qua đã không vui lắm."
        },
        {
          "jp": "りょこうは どうでしたか。……とても よかったです。",
          "vi": "Chuyến du lịch thế nào? ……Rất tuyệt vời ạ."
        }
      ]
    },
    {
      "id": "l12_g03",
      "pattern": "3. Danh từ 1 は Danh từ 2 より Tính từ です (So sánh hơn)",
      "explanation": "Lấy Danh từ 2 làm chuẩn để so sánh tính chất hoặc trạng thái của Danh từ 1. Có nghĩa là: \"N1 thì ... hơn N2\".",
      "note": "より có nghĩa là \"so với\". Ví dụ: このくるまは あのくるまより おおきいです.",
      "examples": [
        {
          "jp": "この くるまは あの くるまより おおきいです。",
          "vi": "Chiếc xe ô-tô này lớn hơn chiếc xe ô-tô kia."
        },
        {
          "jp": "ほっかいどうは きゅうしゅうより おおきいです。",
          "vi": "Hokkaido lớn hơn Kyushu."
        }
      ]
    },
    {
      "id": "l12_g04",
      "pattern": "4. Danh từ 1 と Danh từ 2 と どちらが Tính từ ですか",
      "explanation": "Mẫu câu so sánh lựa chọn giữa 2 đối tượng (đồ vật, người, địa điểm). Dù đối tượng là gì đều dùng nghi vấn từ どちら (cái nào/bên nào trong hai cái).\n• Trả lời: [Danh từ の ほうが Tính từ です] (N thì... hơn).\n• Nếu bằng nhau: どちらも Tính từ です (Cả hai đều...).",
      "note": "の ほうが có nghĩa là \"phía bên này hơn\".",
      "examples": [
        {
          "jp": "サッカーと やきゅうと どちらが おもしろいですか。……サッカーの ほうが おもしろいです。",
          "vi": "Bóng đá và bóng chày môn nào thú vị hơn? ……Bóng đá thú vị hơn."
        },
        {
          "jp": "うみと やまと どちらが すきですか。……どちらも すきです。",
          "vi": "Biển và núi anh thích nơi nào hơn? ……Tôi thích cả hai."
        }
      ]
    },
    {
      "id": "l12_g05",
      "pattern": "5. Danh từ 1 [の 中] で 何 / どこ / だれ / いつ が いちばん Tính từ ですか (So sánh nhất)",
      "explanation": "Biểu thị sự so sánh nhất trong một phạm vi (Danh từ 1).\n• Dùng で sau phạm vi so sánh.\n• Dùng từ để hỏi thích hợp: 何 (cái gì), どこ (ở đâu), だれ (ai), いつ (khi nào).\n• Câu trả lời: [Danh từ 2 が いちばん Tính từ です].",
      "note": "Trợ từ が đứng sau nghi vấn từ và đứng sau đối tượng đạt mức nhất.",
      "examples": [
