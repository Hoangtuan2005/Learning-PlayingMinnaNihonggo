  "grammar": [
    {
      "id": "l07_g01",
      "pattern": "1. Danh từ (công cụ / phương tiện) で Động từ",
      "explanation": "Trợ từ で biểu thị công cụ, dụng cụ hoặc phương tiện được dùng để thực hiện hành động (như ăn bằng đũa, viết bằng bút, nói bằng tiếng Nhật).",
      "note": "Ví dụ: はしで たべます (Ăn bằng đũa), にほんごで レポートを かきます (Viết báo cáo bằng tiếng Nhật).",
      "examples": [
        {
          "jp": "はしで たべます。",
          "vi": "Tôi ăn cơm bằng đũa."
        },
        {
          "jp": "にほんごで レポートを かきます。",
          "vi": "Tôi viết báo cáo bằng tiếng Nhật."
        }
      ]
    },
    {
      "id": "l07_g02",
      "pattern": "2. \"Từ/Câu\" は 〜語で 何ですか",
      "explanation": "Mẫu câu dùng để hỏi nghĩa của một từ, một câu được nói như thế nào bằng một ngôn ngữ khác.",
      "note": "Ví dụ: 「ありがとう」は えいごで 何ですか。➔ 「Thank you」です。",
      "examples": [
        {
          "jp": "「ありがとう」は えいごで 何ですか。……「Thank you」です。",
          "vi": "\"Arigato\" tiếng Anh nói thế nào? ……Tiếng Anh nói là \"Thank you\"."
        },
        {
          "jp": "「Thank you」は にほんごで 何ですか。……「ありがとう」です。",
          "vi": "\"Thank you\" tiếng Nhật nói thế nào? ……Tiếng Nhật nói là \"Arigato\"."
        }
      ]
    },
    {
      "id": "l07_g03",
      "pattern": "3. Danh từ 1 (người) に Danh từ 2 を あげます / かします / おしえます",
      "explanation": "Các động từ chỉ hành động hướng ra ngoài như あげます (cho, tặng), かします (cho mượn), おしえます (dạy). Trợ từ に đặt sau người tiếp nhận hành vi.",
      "note": "KHÔNG dùng あげます khi người khác cho người nói (tôi).",
      "examples": [
        {
          "jp": "わたしは きむらさんに はなを あげました。",
          "vi": "Tôi đã tặng hoa cho chị Kimura."
        },
        {
          "jp": "わたしは イーさんに ほんを かしました。",
          "vi": "Tôi cho chị Lee mượn sách."
        },
        {
          "jp": "わたしは やまださんに えいごを おしえます。",
          "vi": "Tôi dạy tiếng Anh cho ông Yamada."
        }
      ]
    },
    {
      "id": "l07_g04",
      "pattern": "4. Danh từ 1 (người/tổ chức) に (から) Danh từ 2 を もらいます / かります / ならいます",
      "explanation": "Các động từ chỉ hành động nhận vào như もらいます (nhận), かります (mượn, vay), ならいます (học). Trợ từ に (hoặc から) đặt sau người/tổ chức cung cấp.",
      "note": "Khi đối tượng cung cấp là một tổ chức (công ty, trường học, ngân hàng) thì dùng から mà KHÔNG dùng に.",
      "examples": [
        {
          "jp": "わたしは やまださんに はなを もらいました。",
          "vi": "Tôi đã nhận hoa từ ông Yamada."
        },
        {
          "jp": "カリナさんに CDを かりました。",
          "vi": "Tôi đã mượn đĩa CD từ chị Karina."
        },
        {
          "jp": "ぎんこうから おかねを かりました。",
          "vi": "Tôi đã vay tiền từ ngân hàng."
        }
      ]
    },
    {
      "id": "l07_g05",
      "pattern": "5. もう Động từ ました (Đã ... rồi)",
      "explanation": "もう có nghĩa là \"đã/rồi\", đi với động từ thể quá khứ ました để biểu thị một hành động đã hoàn tất ở thời điểm hiện tại.\n• Khẳng định: はい、もう [V ました] (Vâng, đã làm rồi).\n• Phủ định: いいえ、まだです (Chưa, tôi chưa làm).",
      "note": "Tránh dùng 「いいえ、V ませんでした」 vì có nghĩa là \"đã không làm\", chứ không mang nghĩa là tương lai sẽ làm.",
      "examples": [
        {
          "jp": "もう にもつを おくりましたか。……はい、[もう] おくりました。",
          "vi": "Anh/Chị đã gửi đồ chưa? ……Vâng, tôi đã gửi rồi."
        },
        {
          "jp": "もう にもつを おくりましたか。……いいえ、まだです。",
          "vi": "Anh/Chị đã gửi đồ chưa? ……Chưa, tôi chưa gửi."
        }
      ]
    },
    {
      "id": "l07_g06",
      "pattern": "6. Tỉnh lược trợ từ trong hội thoại",
      "explanation": "Trong giao tiếp thân mật hằng ngày, khi ngữ cảnh đã rõ ràng thì các trợ từ như は, を có thể được lược bớt để lời nói tự nhiên hơn.",
      "note": "Ví dụ: このスプーン[は]、すてきですね (Cái thìa này đẹp nhỉ).",
      "examples": [
        {
          "jp": "この スプーン[は]、すてきですね。",
          "vi": "Cái thìa này đẹp quá nhỉ!"
        },
        {
          "jp": "コーヒー[を]、もう いっぱい いかがですか。",
          "vi": "Anh/chị dùng thêm một cốc cà phê nhé?"
        }
      ]
    }
  ]
}