  "grammar": [
    {
      "id": "l09_g01",
      "pattern": "1. Danh từ が あります / わかります / 好きです / 嫌いです / 上手です / 下手です",
      "explanation": "Trong tiếng Nhật, đối tượng của các động từ và tính từ chỉ sở hữu, tri giác, năng lực và cảm xúc không đi với を mà đi với trợ từ が:\n• Sở hữu: くるまが あります (có xe ô tô), おかねが あります (có tiền).\n• Năng lực / Tri giác: にほんごが わかります (hiểu tiếng Nhật), えいごが できます (biết tiếng Anh).\n• Sở thích / Cảm xúc: イタリアりょうりが すきです (thích món Ý), すぽーつが きらいです (ghét thể thao).\n• Năng khiếu: うたが じょうずです (hát giỏi), えが へたです (vẽ kém).",
      "note": "Tuyệt đối không dùng じょうず khi tự khen bản thân mình.",
      "examples": [
        {
          "jp": "わたしは イタリアりょうりが すきです。",
          "vi": "Tôi thích món ăn Ý."
        },
        {
          "jp": "わたしは にほんごが わかります。",
          "vi": "Tôi hiểu tiếng Nhật."
        },
        {
          "jp": "わたしは くるまが あります。",
          "vi": "Tôi có xe ô-tô."
        }
      ]
    },
    {
      "id": "l09_g02",
      "pattern": "2. どんな Danh từ が すきですか (Hỏi thể loại yêu thích)",
      "explanation": "Dùng どんな đi trước danh từ để hỏi rõ thể loại cụ thể mà đối phương yêu thích hoặc giỏi.",
      "note": "Trả lời: [Danh từ cụ thể] が すきです.",
      "examples": [
        {
          "jp": "どんな スポーツが すきですか。……サッカーが すきです。",
          "vi": "Anh/Chị thích môn thể thao nào? ……Tôi thích môn bóng đá."
        }
      ]
    },
    {
      "id": "l09_g03",
      "pattern": "3. Phó từ chỉ mức độ và số lượng",
      "explanation": "Các phó từ đứng trước động từ/tính từ để bổ nghĩa:\n• Đi với câu khẳng định: よく (rất rõ/thường xuyên), だいたい (đại khái), たくさん (nhiều), すこし (một chút).\n• Đi với câu phủ định: あまり (không ~ lắm), ぜんぜん (hoàn toàn không ~).",
      "note": "ぜんぜん luôn đi với đuôi phủ định (V ません / A くないです).",
      "examples": [
        {
          "jp": "えいごが よく わかります。",
          "vi": "Tôi hiểu tiếng Anh rất rõ."
        },
        {
          "jp": "えいごが すこし わかります。",
          "vi": "Tôi hiểu tiếng Anh một chút."
        },
        {
          "jp": "えいごが あまり わかりません。",
          "vi": "Tôi không hiểu tiếng Anh lắm."
        },
        {
          "jp": "おかねが ぜんぜん ありません。",
          "vi": "Tôi hoàn toàn không có đồng nào cả."
        }
      ]
    },
    {
      "id": "l09_g04",
      "pattern": "4. Mệnh đề 1 から、Mệnh đề 2 (Mệnh đề chỉ lý do)",
      "explanation": "Trợ từ から đứng sau mệnh đề 1 biểu thị nguyên nhân, lý do dẫn tới kết quả ở mệnh đề 2. Dịch là: \"Vì... nên...\".\n• Cũng có thể dùng để trả lời câu hỏi lý do: [Mệnh đề からです].",
      "note": "Mệnh đề nguyên nhân đứng trước から, mệnh đề kết quả đứng sau.",
      "examples": [
        {
          "jp": "じかんが ありませんから、しんぶんを よみません。",
          "vi": "Vì không có thời gian nên tôi không đọc báo."
