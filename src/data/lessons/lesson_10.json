  "grammar": [
    {
      "id": "l10_g01",
      "pattern": "1. Danh từ が あります / います (Sự tồn tại)",
      "explanation": "Biểu thị sự tồn tại của đồ vật hoặc người/động vật:\n• あります: Dùng cho đồ vật vô tri vô giác, thực vật không tự chuyển động được (sách, bàn, cây, hoa, xe...).\n• います: Dùng cho người và động vật có thể tự chuyển động được (người, chó, mèo...).",
      "note": "Trợ từ が đứng sau danh từ tồn tại.",
      "examples": [
        {
          "jp": "コンピューターが あります。",
          "vi": "Có máy vi tính."
        },
        {
          "jp": "さくらが あります。",
          "vi": "Có cây hoa anh đào."
        },
        {
          "jp": "おとこの ひとが います。",
          "vi": "Có người đàn ông."
        },
        {
          "jp": "いぬが います。",
          "vi": "Có con chó."
        }
      ]
    },
    {
      "id": "l10_g02",
      "pattern": "2. Địa điểm に Danh từ が あります / います (Ở đâu có cái gì/ai)",
      "explanation": "Trợ từ に đặt sau danh từ chỉ nơi chốn để biểu thị địa điểm nơi sự vật/con người tồn tại.\n• Mẫu câu: [Địa điểm に N が あります/います].\n• Hỏi đồ vật: なにが ありますか (Có cái gì?).\n• Hỏi người/động vật: だれが いますか (Có ai?) / なにが いますか (Có con gì?).",
      "note": "Lưu ý sau nghi vấn từ (なに, だれ) luôn dùng trợ từ が.",
      "examples": [
        {
          "jp": "わたしの へやに つくえが あります。",
          "vi": "Ở trong phòng tôi có một cái bàn."
        },
        {
          "jp": "じむしょに ミラーさんが います。",
          "vi": "Ở văn phòng có anh Miller."
        },
        {
          "jp": "ちかに なにが ありますか。……レストランが あります。",
          "vi": "Ở dưới tầng hầm có cái gì? ……Có nhà hàng."
        },
        {
          "jp": "うけつけに だれが いますか。……きむらさんが います。",
          "vi": "Ở quầy lễ tân có ai? ……Có chị Kimura."
        }
      ]
    },
    {
      "id": "l10_g03",
      "pattern": "3. Danh từ は Địa điểm に あります / います (Cái gì/Ai ở đâu)",
      "explanation": "Đưa danh từ (vật hoặc người) lên làm chủ đề câu với trợ từ は để diễn đạt vị trí nơi tồn tại của danh từ đó.\n• Mẫu câu: [N は Địa điểm に あります/います].\n• Hỏi vị trí: [N は どこに ありますか/いますか] hoặc ngắn gọn [N は どこですか].",
      "note": "Phân biệt với mục 2: Mẫu này nhấn mạnh vào vị trí của đối tượng đã biết trước.",
      "examples": [
        {
          "jp": "とうきょうディズニーランドは ちばけんに あります。",
          "vi": "Công viên Tokyo Disneyland ở tỉnh Chiba."
        },
        {
          "jp": "ミラーさんは じむしょに います。",
          "vi": "Anh Miller ở văn phòng."
        },
        {
          "jp": "とうきょうディズニーランドは どこに ありますか。……ちばけんです。",
          "vi": "Công viên Tokyo Disneyland ở đâu? ……Ở tỉnh Chiba."
        }
      ]
    },
    {
      "id": "l10_g04",
      "pattern": "4. Danh từ 1 (vật/người/địa điểm) の Danh từ 2 (vị trí)",
      "explanation": "Các từ chỉ vị trí phương hướng (うえ, した, まえ, うしろ, みぎ, ひだり, なか, そと, となり, ちかく, あいだ) kết hợp với danh từ qua trợ từ の để tạo thành cụm chỉ vị trí cụ thể.\n• Cụm vị trí này hoạt động như một danh từ chỉ địa điểm: [N1 の N2 に N が あります/います].",
      "note": "Ví dụ: つくえの うえに (ở trên bàn), ほんやと スーパーの あいだに (ở giữa hiệu sách và siêu thị).",
      "examples": [
        {
          "jp": "つくえの うえに しゃしんが あります。",
          "vi": "Ở trên bàn có bức ảnh."
        },
        {
          "jp": "ゆうびんきょくは ぎんこうの となりに あります。",
          "vi": "Bưu điện ở bên cạnh ngân hàng."
        },
        {
          "jp": "ほんやは はなやと スーパーの あいだに あります。",
          "vi": "Hiệu sách ở giữa cửa hàng hoa và siêu thị."
        }
