  "grammar": [
    {
      "id": "l08_g01",
      "pattern": "1. Tính từ trong tiếng Nhật (Tính từ đuôi い & đuôi な)",
      "explanation": "Trong tiếng Nhật tính từ được chia làm hai loại lớn:\n• Tính từ đuôi い: Kết thúc bằng đuôi い (như たかい, さむい, あたらしい). Lưu ý: きれい và ゆうめい kết thúc bằng âm i nhưng là tính từ đuôi な.\n• Tính từ đuôi な: Khi đứng trước danh từ cần thêm な (như しずかな, べんりな).",
      "note": "きれい và ゆうめい là 2 tính từ đuôi な đặc biệt kết thúc bằng chữ い.",
      "examples": [
        {
          "jp": "ふじさんは たかいです。",
          "vi": "Núi Phú Sĩ thì cao."
        },
        {
          "jp": "ワットせんせいは しんせつです。",
          "vi": "Thầy giáo Watt rất tốt bụng."
        }
      ]
    },
    {
      "id": "l08_g02",
      "pattern": "2. Thể phủ định của tính từ (Hiện tại / Tương lai)",
      "explanation": "• Tính từ đuôi な: [Bỏ な] + じゃ (では) ありません.\n  Ví dụ: しずかじゃ ありません (Không yên tĩnh).\n• Tính từ đuôi い: [Bỏ い] + くないです.\n  Ví dụ: たかくないです (Không đắt).\n• Ngoại lệ: いい (tốt) ➔ よくないです (Không tốt).",
      "note": "Ngoại lệ: いいです ➔ よくないです (Không nói い块ないです).",
      "examples": [
        {
          "jp": "あそこは しずかじゃ ありません。",
          "vi": "Chỗ kia không yên tĩnh."
        },
        {
          "jp": "この ほんは おもしろくないです。",
          "vi": "Cuốn sách này không hay."
        },
        {
          "jp": "きょうは てんきが よくないです。",
          "vi": "Hôm nay thời tiết không tốt."
        }
      ]
    },
    {
      "id": "l08_g03",
      "pattern": "3. Tính từ bổ nghĩa cho danh từ",
      "explanation": "Tính từ luôn đứng trước danh từ để bổ nghĩa:\n• Tính từ đuôi な: [Tính từ な] + Danh từ (Ví dụ: しんせつな せんせい - Người thầy tốt bụng).\n• Tính từ đuôi い: [Tính từ い] + Danh từ (Ví dụ: たかい やま - Ngọn núi cao).",
      "note": "Không bỏ な khi tính từ đuôi な đứng trước danh từ.",
      "examples": [
        {
          "jp": "ワットせんせいは しんせつな せんせいです。",
          "vi": "Thầy Watt là một người thầy giáo tốt bụng."
        },
        {
          "jp": "ふじさんは たかい やまです。",
          "vi": "Núi Phú Sĩ là một ngọn núi cao."
        }
      ]
    },
    {
      "id": "l08_g04",
      "pattern": "4. Mệnh đề 1 が、Mệnh đề 2 (Nhưng mà)",
      "explanation": "Liên từ が đặt giữa hai mệnh đề để biểu thị mối quan hệ tương phản, đối lập.",
      "note": "Ví dụ: にほんの たべものは おいしいですが、たかいです (Món ăn Nhật ngon nhưng đắt).",
      "examples": [
        {
          "jp": "にほんの たべものは おいしいですが、たかいです。",
          "vi": "Món ăn Nhật Bản ngon nhưng mà đắt."
        }
      ]
    },
    {
      "id": "l08_g05",
      "pattern": "5. とても / あまり (Phó từ chỉ mức độ)",
      "explanation": "• とても: Rất, lắm (luôn đi cùng câu khẳng định).\n• あまり: Không ~ lắm (luôn đi cùng câu phủ định).",
      "note": "Cả hai phó từ đều đứng trước tính từ.",
      "examples": [
