  "grammar": [
    {
      "id": "l15_g01",
      "pattern": "1. Động từ thể て も いいですか (Xin phép: Làm ~ có được không?)",
      "explanation": "Mẫu câu dùng để xin phép người khác thực hiện một việc gì đó.\n• Đồng ý cho phép: 「ええ、[V ても] いいですよ」 (Vâng, được chứ ạ).\n• Từ chối tế nhị: Nêu lý do từ chối (ví dụ: すみません、ちょっと…… - Xin lỗi, có chút phiền...).",
      "note": "Nếu là nơi cấm tuyệt đối, người ta có thể trả lời bằng thể cấm đoán 「いいえ、V てはいけません」.",
      "examples": [
        {
          "jp": "しゃしんを とっても いいですか。……ええ、いいですよ。",
          "vi": "Tôi chụp ảnh có được không? ……Vâng, được chứ ạ."
        },
        {
          "jp": "ここで たばこを すっても いいですか。……すみません、ここは きんえんですから、すわないで ください。",
          "vi": "Tôi hút thuốc ở đây có được không? ……Xin lỗi, vì ở đây cấm hút thuốc nên xin anh đừng hút."
        }
      ]
    },
    {
      "id": "l15_g02",
      "pattern": "2. Động từ thể て は いけません (Cấm đoán: Không được làm ~)",
      "explanation": "Mẫu câu dùng để biểu thị sự cấm đoán tuyệt đối, không cho phép làm một việc gì đó. Thường dùng trong các quy định, biển báo, hoặc người có thẩm quyền nhắc nhở.",
      "note": "Không dùng mẫu câu này với người trên hoặc người lớn tuổi hơn mình.",
      "examples": [
        {
          "jp": "ここで たばこを すっては いけません。きんえんですから。",
          "vi": "Không được hút thuốc ở đây. Vì ở đây cấm hút thuốc."
        },
        {
          "jp": "あぶないですから、ここへ はいっては いけません。",
          "vi": "Vì nguy hiểm nên không được vào đây."
        }
      ]
    },
    {
      "id": "l15_g03",
      "pattern": "3. Động từ thể て います (Biểu thị trạng thái kết quả kéo dài)",
      "explanation": "Ngoài việc biểu thị hành động đang diễn ra (Bài 14), mẫu [V て います] còn diễn tả trạng thái là kết quả của một hành động đã xảy ra trong quá khứ và kết quả đó vẫn đang tồn tại ở hiện tại:\n• Kết hôn: けっこんして います (Đã kết hôn/Có gia đình).\n• Nhận biết: しって います (Biết).\n• Sở hữu: もって います (Có, sở hữu đồ vật).\n• Nơi ở: すんで います (Đang sinh sống ở đâu đó).\n• Lưu ý đặc biệt: Phủ định của しって います LUÔN LÀ 「しりません」 (Không nói しっていません).",
      "note": "Phủ định của 知っています là 知りません.",
      "examples": [
        {
          "jp": "わたしは けっこんして います。",
          "vi": "Tôi đã lập gia đình."
        },
        {
          "jp": "たなかさんを しって いますか。……はい、しって います。",
          "vi": "Anh có biết anh Tanaka không? ……Vâng, tôi biết."
        },
        {
          "jp": "たなかさんを しって いますか。……いいえ、しりません。",
          "vi": "Anh có biết anh Tanaka không? ……Không, tôi không biết."
        },
        {
          "jp": "わたしは おおさかに すんで います。",
          "vi": "Tôi đang sống ở Osaka."
        }
      ]
    },
    {
      "id": "l15_g04",
      "pattern": "4. Danh từ に Động từ (Điểm đến của kết quả hành động)",
      "explanation": "Trợ từ に dùng sau danh từ địa điểm để biểu thị nơi lưu lại kết quả của các động từ như はいります (vào), すわります (ngồi), のります (lên tàu xe), おきます (đặt để).",
      "note": "Ví dụ: ここに すわって ください (Hãy ngồi vào đây); ここに はいっては いけません (Không được vào đây).",
      "examples": [
        {
          "jp": "ここに はいっては いけません。",
          "vi": "Không được vào đây."
        },
        {
          "jp": "ここに すわっても いいですか。",
          "vi": "Tôi ngồi ở đây có được không?"
        }
      ]
    },
    {
      "id": "l15_g05",
      "pattern": "5. Danh từ 1 に Danh từ 2 を Động từ (Vị trí đặt/đỗ đồ vật)",
      "explanation": "Trợ từ に chỉ nơi đối tượng (Danh từ 2) được đặt hoặc lưu lại sau khi thực hiện hành động.",
      "note": "Ví dụ: ここに くるまを とめて ください (Anh/chị hãy đỗ xe ở đây).",
      "examples": [
        {
          "jp": "ここに くるまを とめて ください。",
          "vi": "Anh/Chị hãy đỗ xe ở chỗ này."
        },
        {
          "jp": "ここに じゅうしょを かいて ください。",
          "vi": "Anh/Chị hãy ghi địa chỉ vào đây."
        }
      ]
    }
  ]
}