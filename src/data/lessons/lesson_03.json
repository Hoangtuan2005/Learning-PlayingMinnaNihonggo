  "grammar": [
    {
      "id": "l03_g01",
      "pattern": "1. ここ / そこ / あそこ / こちら / そちら / あちら",
      "explanation": "Hệ thống đại từ chỉ nơi chốn và phương hướng trong tiếng Nhật:\n• 「ここ」: Chỉ vị trí người nói đang ở (gần người nói).\n• 「そこ」: Chỉ vị trí người nghe đang ở (gần người nghe).\n• 「あそこ」: Chỉ vị trí xa cả người nói lẫn người nghe.\n• 「こちら / そちら / あちら」: Vốn là đại từ chỉ phương hướng (hướng này / hướng đó / hướng kia), đồng thời được sử dụng thay cho ここ / そこ / あそこ để chỉ địa điểm với sắc thái trang trọng, lịch sự hơn nhiều.",
      "note": "Khi cả hai người cùng đứng chung một khu vực: dùng ここ (nơi 2 người đang đứng), そこ (hơi xa 2 người), あそこ (xa hẳn cả 2 người).",
      "examples": [
        {
          "jp": "ここは きょうしつです。",
          "vi": "Chỗ này là lớp học."
        },
        {
          "jp": "あちらは じむしょです。",
          "vi": "Phía kia là văn phòng (nói lịch sự)."
        }
      ]
    },
    {
      "id": "l03_g02",
      "pattern": "2. Danh từ は địa điểm です",
      "explanation": "Mẫu câu dùng để diễn đạt người, vật hay địa điểm nào đó đang ở đâu.\nCông thức: [Chủ ngữ / Người / Vật] は [Nơi chốn / Địa điểm / Tầng] です。",
      "note": "Địa điểm có thể là tên phòng (じむしょ), vị trí (あそこ, こちら), hoặc số tầng (2かい).",
      "examples": [
        {
          "jp": "おてあらいは あそこです。",
          "vi": "Nhà vệ sinh ở đằng kia."
        },
        {
          "jp": "でんわは ２かいです。",
          "vi": "Điện thoại ở tầng hai."
        },
        {
          "jp": "やまださんは じむしょです。",
          "vi": "Anh Yamada ở văn phòng."
        }
      ]
    },
    {
      "id": "l03_g03",
      "pattern": "3. どこ / どちら (Hỏi địa điểm & Tổ chức)",
      "explanation": "• 「どこ」: Nghi vấn từ hỏi về địa điểm (Ở đâu?).\n• 「どちら」: Nghi vấn từ hỏi về phương hướng (Phía nào?), đồng thời dùng để hỏi địa điểm với sắc thái lịch sự hơn どこ.\n• Lưu ý quan trọng: Khi hỏi tên của quốc gia, trường học, công ty trực thuộc... người Nhật dùng どこ hoặc どちら, tuyệt đối KHÔNG dùng なん (gì).",
      "note": "Hỏi công ty/trường học: 「かいしゃは どちらですか」 (Anh làm việc ở công ty nào?), không hỏi 「なんの かいしゃ」.",
      "examples": [
        {
          "jp": "おてあらいは どこですか。……あそこです。",
          "vi": "Nhà vệ sinh ở đâu vậy? ……Ở đằng kia."
        },
        {
          "jp": "エレベーターは どちらですか。……あちらです。",
          "vi": "Thang máy ở phía nào vậy ạ? ……Ở phía kia ạ."
        },
        {
          "jp": "がっこうは どこですか。",
          "vi": "Anh học ở trường nào?"
        },
        {
          "jp": "かいしゃは どちらですか。",
          "vi": "Chị làm việc ở công ty nào ạ?"
        }
      ]
    },
    {
      "id": "l03_g04",
      "pattern": "4. Danh từ 1 の Danh từ 2 (Xuất xứ & Nhà sản xuất)",
      "explanation": "Trong cấu trúc [N1 の N2], trợ từ の dùng để chỉ:\n1) Nơi sản xuất / Xuất xứ: N1 là quốc gia, N2 là sản phẩm ➔ Sản phẩm của nước đó.\n2) Hãng sản xuất: N1 là công ty, N2 là sản phẩm ➔ Sản phẩm của công ty đó.\nKhi hỏi về xuất xứ hoặc nhà sản xuất, ta dùng nghi vấn từ: 「これは どこ / どちらの N ですか。」",
      "note": "Trả lời có thể nói rõ xuất xứ nước hoặc tên công ty.",
      "examples": [
        {
          "jp": "これは どこの コンピューターですか。……にほんの コンピューターです。",
          "vi": "Đây là máy vi tính của nước nào? ……Là máy tính của Nhật Bản."
        },
        {
          "jp": "これは どこの コンピューターですか。……パワーでんきの コンピューターです。",
          "vi": "Đây là máy tính của hãng nào? ……Là máy tính của công ty điện lực Power."
        }
      ]
    },
    {
      "id": "l03_g05",
      "pattern": "5. Bảng hệ thống chỉ thị từ こ / そ / あ / ど",
      "explanation": "Tổng kết hệ thống chỉ thị từ tiếng Nhật theo 4 cấp độ khoảng cách:\n• Đồ vật độc lập: これ (cái này) | それ (cái đó) | あれ (cái kia) | どれ (cái nào)\n• Đồ vật/người đi kèm N: この N (N này) | その N (N đó) | あの N (N kia) | どの N (N nào)\n• Địa điểm: ここ (chỗ này) | そこ (chỗ đó) | あそこ (chỗ kia) | どこ (chỗ nào)\n• Phương hướng / Lịch sự: こちら (phía này) | そちら (phía đó) | あちら (phía kia) | どちら (phía nào)",
      "note": "Quy tắc khoảng cách: こ (gần người nói) ➔ そ (gần người nghe) ➔ あ (xa cả hai) ➔ ど (nghi vấn từ để hỏi).",
      "examples": [
        {
